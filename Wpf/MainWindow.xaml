<Window x:Class="Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf"
        mc:Ignorable="d"
        Title="Задачки" Height="350" Width="550" WindowStyle="ThreeDBorderWindow">
    <Grid x:Name="MainRoot" Background="White" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="titleBox" Width="260" Margin="0,0,10,0"/>
            <TextBlock Text="Приоритет (1-3):" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="priorityBox" Width="30" Text="2" Margin="0,0,10,0"/>
            <Button Content="Добавить" Padding="10,2" Click="AddButton_Click"/>
        </StackPanel>
        
        <ListBox x:Name="listBox" Grid.Row="1"/>

        <StackPanel Grid.Row="2" Orientation="HoriZontal" Margin="0,10,0,0">
            <Button Content="Выполнить" Padding="10,2" Margin="0,0,10,0" Click="CompleteButton_Click"/>
            <Button Content="Переименовать" Padding="10,2" Margin="0,0,10,0" Click="RenameButton_Click"/>
            <Button Content="Удалить" Padding="10,2" Click="DeleteButton_Click"/>
        </StackPanel>
    </Grid>
  
</Window>
