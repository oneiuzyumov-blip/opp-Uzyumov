<Window x:Class="PaintLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PaintLab"
        Title="Графический редактор" Height="600" Width="1150"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="RadioButton"
               BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="4" Background="#F0F0F0">
            <StackPanel x:Name="ToolPanel" Orientation="Horizontal"/>

            <TextBlock Text="Цвет:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <ComboBox x:Name="ColorBox" Width="100" DisplayMemberPath="Name"/>

            <TextBlock Text="Толщина:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <Slider x:Name="WidthSlider" Width="120" Minimum="1" Maximum="20" Value="2"
                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Value, ElementName=WidthSlider, StringFormat=N0}"
                       Width="24" VerticalAlignment="Center" Margin="4,0"/>

            <Button Content="Отменить (Ctrl+Z)" Margin="12,2,2,2" Padding="8,3" Click="Undo_Click"/>
            <Button Content="Повторить (Ctrl+Y)" Margin="2" Padding="8,3" Click="Redo_Click"/>
            <Button Content="Очистить" Margin="2" Padding="8,3" Click="Clear_Click"/>
            <Button Content="Сохранить" Margin="12,2,2,2" Padding="8,3" Click="Save_Click"/>
            <Button Content="Открыть" Margin="2" Padding="8,3" Click="Open_Click"/>
            <Button Content="Экспорт PNG" Margin="12,2,2,2" Padding="8,3" Click="Export_Click"/>
        </WrapPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="Status"/>
        </StatusBar>

        <Border BorderBrush="Gray" BorderThickness="1" Margin="4">
            <local:DrawingSurface x:Name="Surface"
                                  MouseLeftButtonDown="Surface_MouseDown"
                                  MouseMove="Surface_MouseMove"
                                  MouseLeftButtonUp="Surface_MouseUp"/>
        </Border>
    </DockPanel>
</Window>
